# Local development defaults. docker-compose.yml applies the same values when a variable is unset.
DB_NAME=washgate
DB_USER=washgate
DB_PASSWORD=washgate
DB_ROOT_PASSWORD=washgate-root
MARIADB_PORT=3306
CENTRAL_PORT=8080
# Bearer token site-1 presents to central. A local development value, not a secret.
SITE_TOKEN=local-dev-site-token-not-a-secret
# Stripe test key (sk_test_ or rk_test_), on an account whose default API version is 2025-03-31.basil. Empty turns Stripe off.
STRIPE_SECRET_KEY=
# Print it with: docker compose run --rm stripe-cli listen --print-secret --api-key <test key>
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=http://localhost:5173/
CHECKOUT_CANCEL_URL=http://localhost:5173/
