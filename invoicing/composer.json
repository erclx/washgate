{
  "name": "erclx/washgate-invoicing",
  "description": "Monthly fleet invoicing for washgate",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "autoload": {
    "psr-4": {
      "Washgate\\Invoicing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Washgate\\Invoicing\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5"
  }
}
